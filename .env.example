# Base URL of the Express API (used when VITE_USE_MOCKS=false)
VITE_API_URL=http://localhost:3000/api

# true  -> services resolve against the in-browser mock layer (src/services/mocks)
# false -> services call the real API through src/services/api/apiClient.ts
VITE_USE_MOCKS=true

# Artificial latency (ms) applied to every mock call
VITE_MOCK_DELAY=450

# Probability (0..1) that a mock call fails — useful to demo error states
VITE_MOCK_FAILURE_RATE=0

# Product name shown across the UI
VITE_APP_NAME=EventFlow
